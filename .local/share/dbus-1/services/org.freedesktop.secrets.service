# Overrides /usr/share/dbus-1/services/org.freedesktop.secrets.service so that
# D-Bus activation starts gnome-keyring-daemon through its systemd unit (with
# the check/unlock/heal drop-in) instead of dbus-broker spawning a bare daemon
# that skips all of it. See SETUP.md step 13.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/gnome-keyring-daemon --start --foreground --components=secrets
SystemdService=gnome-keyring-daemon.service
