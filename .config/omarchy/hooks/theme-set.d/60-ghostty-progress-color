#!/bin/bash
# Recolor Ghostty's OSC 9;4 progress bar to the current Omarchy theme accent.
# Ghostty loads the generated file via `gtk-custom-css` in ~/.config/ghostty/config.
set -u

COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"
OUT="$HOME/.local/state/ghostty/progress.css"

accent=$(sed -n 's/^accent *= *"\(#[0-9A-Fa-f]\{6\}\)".*/\1/p' "$COLORS" 2>/dev/null | head -1)
[[ -n $accent ]] || exit 0

mkdir -p "${OUT%/*}"
cat > "$OUT" <<CSS
/* Generated by theme-set hook 60-ghostty-progress-color - do not edit */
progressbar:not(.error) > trough > progress {
  background-color: $accent;
  border-color: $accent;
}
CSS

# Ask running Ghostty instances to reload their config (picks up the new CSS)
pkill -USR2 -x ghostty 2>/dev/null || true
